# Active settings copied from Svtlv; keep the Jev key in the global config
# (~/.config/agrouter/config or AGROUTER_CONFIG_DIR) or TYPESAFE_API_KEY.

[agrouter]
jev_model = jev-latest
timeout   = 30s

routing_policy = Choose the option with the lowest cost that can reliably satisfy this task's requirements. Compare the supplied model prices and the effort descriptions, including their effect on token usage. Prefer cheaper options when their capabilities are sufficient. Choose a more expensive model or higher effort when it materially improves the likelihood of completing this specific task correctly. Prefer less time when cost and capability are comparable. The project complexity, when present, rates the codebase the task runs in: use it as context for how hard this specific task is there, not as a substitute for judging the task (a typo fix stays trivial in any codebase).
complexity_policy = Judge the codebase as a whole: its size, architecture, dependencies and constraints, not any single task in it.

[cli.claude]
enabled         = true
command         = claude
description     = Claude Code (Anthropic). Agentic coding CLI with file editing, shell, subagents (Task tool) and MCP.
exec_args       = ["-p"]
model_args      = ["--model", "{model}"]
effort_args     = ["--effort", "{effort}"]
prompt_args     = ["--", "{prompt}"]

[cli.claude.availability]
enabled = true
checks  = usage
timeout = 5s
unknown = allow

[cli.claude.availability.usage]
transport     = sdk-control-usage-v1
args          = ["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose", "--no-session-persistence", "--strict-mcp-config", "--settings", "{\"disableAllHooks\":true}"]
min_version   = 2.1.296
error_prefix  = "agrouter: "
error_message = You've hit your limit

[cli.codex]
enabled               = true
command               = codex
description           = Codex CLI (OpenAI). Agentic coding CLI with sandboxed shell, apply_patch and multi-agent spawn_agent.
exec_args             = ["exec"]
model_args            = ["--model", "{model}"]
effort_args           = ["-c", "model_reasoning_effort=\"{effort}\""]
prompt_args           = ["--", "{prompt}"]

[cli.codex.availability]
enabled = true
checks  = limits
timeout = 5s
unknown = allow

[cli.codex.availability.limits]
transport     = jsonrpc-ratelimits-v1
args          = ["app-server"]
min_version   = 0.162.1
error_prefix  = "agrouter: "
error_message = You've hit your usage limit

[model.claude-fable-5-1]
enabled     = true
cli         = claude
name        = claude-fable-5-1
aliases     = fable
efforts     = low, medium, high, xhigh, max
description = Most capable model open to all customers. For demanding reasoning and long-horizon agentic work: multi-hour agent sessions, multistep deep research, analysis carried through to a finished document, spreadsheet or deck. Use when Opus 5.5 at higher effort still falls short. Slower; input USD 10 / output USD 50 per million tokens.
source      = https://platform.claude.com/docs/en/models/fable-5-1/overview

[model.claude-opus-5-5]
enabled     = true
cli         = claude
name        = claude-opus-5-5
aliases     = opus
efforts     = low, medium, high, xhigh, max
description = For long-running agentic coding and knowledge work: multi-hour autonomous coding, large-scale refactoring, complex systems engineering, vision-heavy workflows. Recommended starting point for most workloads. Moderate latency; input USD 4 / output USD 20 per million tokens.
source      = https://platform.claude.com/docs/en/models/opus-5-5/overview

[model.claude-sonnet-5-5]
enabled     = true
cli         = claude
name        = claude-sonnet-5-5
aliases     = sonnet
efforts     = low, medium, high, xhigh, max
description = Best combination of speed and intelligence. Everyday coding, code generation, data analysis, agentic tool use. Fast; input USD 2 / output USD 10 per million tokens.
source      = https://platform.claude.com/docs/en/models/sonnet-5-5/overview

[model.claude-haiku-5-5]
enabled     = true
cli         = claude
name        = claude-haiku-5-5
aliases     = haiku
efforts     = low, medium, high, xhigh, max
description = Fastest model, for high-volume, latency-sensitive work: classification, extraction, routing, chat, short tool tasks, subagent tasks. Use medium for most work including agentic coding, low for simple high-volume requests, high for longer agent tasks and strict instruction following. Fastest; input USD 0.10 / output USD 0.50 per million tokens (USD 0.50 / 2.50 for prompts over 100K tokens).
source      = https://platform.claude.com/docs/en/models/haiku-5-5/overview

[effort.claude.low]
enabled     = true
description = Most efficient: significant token savings with some capability reduction. Simpler tasks that need speed and low cost, such as subagents.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.medium]
enabled     = true
description = Balanced, with moderate token savings. Agentic tasks balancing speed, cost and performance.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.high]
enabled     = true
description = Spends as many tokens as the task needs for excellent results. Complex reasoning, difficult coding problems, agentic tasks.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.xhigh]
enabled     = true
description = Extended capability for long-horizon work: long-running agentic and coding tasks (over 30 minutes).
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.max]
enabled     = true
description = Absolute maximum capability with no limit on token spending. The deepest reasoning; can overthink simple or structured tasks.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

