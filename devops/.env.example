# copy to .env next to docker-compose.yaml; docker-compose reads it automatically.
# own project name, so a local run does not share Svtlv's "devops" project
COMPOSE_PROJECT_NAME=lampa

# Test (default) or Production run in containers; Development is for a local "go run" of
# backend/ against the DB published on LAMPA_DB_PORT
LAMPA_ENVIRONMENT=Test

# lampa-web build args, substituted into msx/start.json
LAMPA_DOMAIN=localhost:8092
LAMPA_PREFIX=http://

# published host ports
LAMPA_PORT=8092
LAMPA_API_PORT=5800
LAMPA_DB_PORT=5434

# secrets, placeholders only. generate real values with:
#   LAMPA_DB_PASSWORD:  openssl rand -hex 32
#   LAMPA_API_DATA_KEY: openssl rand -base64 32
LAMPA_DB_PASSWORD=change-me
LAMPA_API_DATA_KEY=bG9jYWwtb25seS1wbGFjZWhvbGRlci1ub3QtYS1rZXk=
