{
  "Api": {
    "Listen": ":5800",
    "MaxBodyBytes": 2097152
  },
  "Health": {
    "Listen": ":8081"
  },
  "Database": {
    "Host": "localhost",
    "Port": 5434,
    "Name": "lampa",
    "User": "lampa",
    "Password": "{LAMPA_DB_PASSWORD}",
    "SSLMode": "disable"
  },
  "DataKey": "{LAMPA_API_DATA_KEY}",
  "Auth": {
    "PublicURL": "{LAMPA_PUBLIC_URL}",
    "Issuer": "{LAMPA_KEYCLOAK_ISSUER}",
    "ClientID": "svtlv-lampa",
    "ClientSecret": "{LAMPA_KEYCLOAK_CLIENT_SECRET}"
  }
}
