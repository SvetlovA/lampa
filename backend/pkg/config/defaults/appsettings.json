    "Keycloak": {
      "Authority": "https://svtlv.fly.dev/realms/svtlv-test",
      "ClientId": "svtlv-lampa",
      "ClientSecret": "{LAMPA_KEYCLOAK_CLIENT_SECRET}",
      "RequireHttpsMetadata": false
    }
  }
}
